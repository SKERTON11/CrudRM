# Treat text files as text and normalize line endings
* text=auto

# Force Unix line endings for source files
*.php text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.json text eol=lf

# Binary files should not be normalized
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.glb binary
*.gltf binary
